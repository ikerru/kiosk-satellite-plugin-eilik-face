{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "eilik-face",
  "name": "Cara Eilik",
  "version": "0.1.0",
  "minAndroidSdk": 24,
  "entryClass": "eilik.face.EilikFacePlugin",
  "description": "Protector de pantalla con una cara de robot al estilo Eilik. Reacciona al asistente de voz: escucha cuando le hablas, piensa mientras procesa y habla cuando responde.",
  "author": "ikerru",
  "license": "Apache-2.0",
  "capabilities": ["screensaver", "host.read"],
  "settings": [
    {"key": "eyeColor", "title": "Color de los ojos (reposo)", "type": "color", "default": "#35E0FF", "group": "Aspecto"},
    {"key": "bgColor", "title": "Color de fondo", "type": "color", "default": "#000000", "group": "Aspecto"},
    {"key": "eyeSize", "title": "Tamaño de la cara (%)", "type": "number", "default": 100, "min": 50, "max": 150, "step": 5, "group": "Aspecto"},
    {"key": "showMouth", "title": "Mostrar boca al hablar", "type": "boolean", "default": false, "group": "Aspecto"},
    {"key": "sleepMinutes", "title": "Dormirse tras (minutos, 0 = nunca)", "type": "number", "default": 10, "min": 0, "max": 60, "step": 1, "group": "Aspecto"},
    {"key": "assistEntity", "title": "Entidad assist_satellite", "type": "entity", "default": "", "group": "Voz",
     "description": "Opcional pero recomendada: permite distinguir escuchar, pensar y hablar. Sin ella solo se distingue 'te escucha' de 'reposo'."},
    {"key": "listenColor", "title": "Color al escucharte", "type": "color", "default": "#7CFF8A", "group": "Voz"},
    {"key": "thinkColor", "title": "Color al pensar", "type": "color", "default": "#FFC857", "group": "Voz"},
    {"key": "speakColor", "title": "Color al responder", "type": "color", "default": "#FF8AD8", "group": "Voz"}
  ],
  "commands": [
    {"id": "demo", "title": "Demo de estados"}
  ]
}
